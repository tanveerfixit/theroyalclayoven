# ─────────────────────────────────────────────────────────────────────────────
# THE ROYAL CLAY OVEN — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
DB_HOST="your-db-host"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_DATABASE="your-db-name"
DB_PORT=3306

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="production"

# ── SMTP Outgoing Email ──────────────────────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="customers@yourdomain.ie"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="true"

# ── Admin Authentication ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET="your-64-char-random-hex-string"

# ── Admin Users (comma-separated, seeded on first startup) ──────────────────
ADMIN_SEED_EMAILS="admin@yourdomain.ie"

# ── Order Notification Fallback Emails (comma-separated) ────────────────────
NOTIFICATION_FALLBACK_EMAILS="sales@yourdomain.ie"

# ── Google OAuth (for Google One Tap sign-in) ────────────────────────────────
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ── Gemini AI (optional) ──────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
